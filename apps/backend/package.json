{
  "name": "@kinestem/backend",
  "version": "1.0.0",
  "description": "KINESTEM Backend - Express, PostgreSQL, MongoDB, Serial y WebSockets",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --disable-proto=delete -r tsx/esm ./src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-proto=delete dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting backend...'"
  },
  "dependencies": {
    "@kinestem/shared-types": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "pg": "^8.13.1",
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
