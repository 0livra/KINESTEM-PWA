{
  "name": "kinestem-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KINESTEM - Consola Educativa STEM Interactiva (Monorepo)",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "dev:backend": "pnpm --filter @kinestem/backend run dev",
    "dev:frontend": "pnpm --filter @kinestem/frontend run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive exec -- rm -rf dist node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
