# =============================================================================
# KINESTEM - Variables de Entorno Globales (Plantilla)
# =============================================================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de Datos Relacional: PostgreSQL (Identidad, Partidas, Economía)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=admin
PG_DATABASE=kinestem_db
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_POOL_CONNECTION_TIMEOUT_MS=5000

# Base de Datos Documental: MongoDB (Telemetría de alta frecuencia)
MONGO_URI=mongodb://localhost:27017/kinestem_telemetry

# Hardware Gateway: Comunicación Serial con Arduino UNO R3 (Hardware real COM6)
SERIAL_PORT=COM6
BAUD_RATE=9600
SERIAL_BAUD_RATE=9600
USE_MOCK_SERIAL=false
SERIAL_MOCK=false

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_kinestem_2026_dev
CORS_ORIGIN=*
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_RATE=10

# Frontend (Vite PWA SPA)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
